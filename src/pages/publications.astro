---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const videoSrc = "/videos/works/work13.mp4";
---

<Layout>
  <Header />
  
  <div class="publications-page">
    <video
      class="pub-bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src={`${videoSrc}#t=20`} type="video/mp4" />
    </video>
    <div class="pub-overlay"></div>

    <main class="pub-container">
      <header class="pub-page-header">
        <h1>Publications</h1>
      </header>

      <div class="pub-content">
        <!-- Publication 1: Being-in-the-World -->
        <article class="pub-item">
          <header class="pub-item-header">
            <div class="pub-header-main">
              <h2 class="pub-title">Being-in-the-World</h2>
              <p class="pub-subtitle">Ästhetische Reflexion über die Geworfenheit und existentielle Angst des Daseins</p>
            </div>
            <div class="pub-meta-info">
              <div class="pub-meta-col">
                <span class="pub-meta-label">Erscheinungsjahr</span>
                <span class="pub-meta-value">2022</span>
              </div>
              <div class="pub-meta-col">
                <span class="pub-meta-label">Seitenzahl</span>
                <span class="pub-meta-value">30</span>
              </div>
              <div class="pub-meta-col">
                <span class="pub-meta-label">Herausgeber</span>
                <span class="pub-meta-value">
                  <a href="https://www.hbksaar.de" target="_blank" rel="noopener noreferrer">
                    HBKsaar
                  </a>
                </span>
              </div>
              <div class="pub-meta-col pub-meta-col-wide">
                <span class="pub-meta-label">Autor</span>
                <span class="pub-meta-value">Kyung Jae Kim</span>
              </div>
            </div>
          </header>
          <div class="pub-grid">
            <div class="pub-image-wrapper" style="aspect-ratio: 1191/842;">
              <img
                src="/publication/BA/BA1.png"
                alt="Being-in-the-World - Bachelorarbeit 1"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 1191/842;">
              <img
                src="/publication/BA/BA2.png"
                alt="Being-in-the-World - Bachelorarbeit 2"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 1191/842;">
              <img
                src="/publication/BA/BA3.png"
                alt="Being-in-the-World - Bachelorarbeit 3"
                class="pub-image"
                loading="lazy"
              />
            </div>
          </div>
        </article>

        <!-- Publication 2: Design / Demokratie -->
        <article class="pub-item">
          <header class="pub-item-header">
            <div class="pub-header-main">
              <h2 class="pub-title">Design / Demokratie</h2>
              <p class="pub-subtitle">„Design ist nicht demokratisch…“ – sollte es aber womöglich sein!</p>
            </div>
            <div class="pub-meta-info">
              <div class="pub-meta-col">
                <span class="pub-meta-label">Erscheinungsjahr</span>
                <span class="pub-meta-value">2019</span>
              </div>
              <div class="pub-meta-col">
                <span class="pub-meta-label">Seitenzahl</span>
                <span class="pub-meta-value">112</span>
              </div>
              <div class="pub-meta-col">
                <span class="pub-meta-label">ISBN</span>
                <span class="pub-meta-value">
                  <a href="https://www.isbn.de/buch/9783943264227/design-demokratie" target="_blank" rel="noopener noreferrer">
                    978-3-943264-22-7
                  </a>
                </span>
              </div>
              <div class="pub-meta-col">
                <span class="pub-meta-label">Herausgeber</span>
                <span class="pub-meta-value">
                  <a href="https://www.hbksaar.de" target="_blank" rel="noopener noreferrer">
                    HBKsaar
                  </a>
                </span>
              </div>
              <div class="pub-meta-col pub-meta-col-wide">
                <span class="pub-meta-label">Autor*innen</span>
                <span class="pub-meta-value">Studierende der HBKsaar, Professor*innen und Gäste</span>
              </div>
            </div>
          </header>
          <div class="pub-grid">
            <div class="pub-image-wrapper" style="aspect-ratio: 800/1058;">
              <img
                src="/publication/DE/DE1.jpeg"
                alt="Design / Demokratie - Cover"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 1500/1000;">
              <img
                src="/publication/DE/DE2.jpeg"
                alt="Design / Demokratie - Spreads 1"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 320/213;">
              <img
                src="/publication/DE/DE3.jpeg"
                alt="Design / Demokratie - Spreads 2"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 1500/1000;">
              <img
                src="/publication/DE/DE4.jpeg"
                alt="Design / Demokratie - Spreads 3"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 320/213;">
              <img
                src="/publication/DE/DE5.jpeg"
                alt="Design / Demokratie - Spreads 4"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 1500/1000;">
              <img
                src="/publication/DE/DE6.jpeg"
                alt="Design / Demokratie - Spreads 5"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 1500/1072;">
              <img
                src="/publication/DE/DE7.jpeg"
                alt="Design / Demokratie - Spreads 6"
                class="pub-image"
                loading="lazy"
              />
            </div>
          </div>
        </article>

        <!-- Publication 3: Das Netzwerk der Klangkunst -->
        <article class="pub-item">
          <header class="pub-item-header">
            <div class="pub-header-main">
              <h2 class="pub-title">Das Netzwerk der Klangkunst</h2>
              <p class="pub-subtitle">Resonanz und Differenz: Deutsche Klangkunst und koreanische Sound Art im Dialog</p>
            </div>
            <div class="pub-meta-info">
              <div class="pub-meta-col">
                <span class="pub-meta-label">Erscheinungsjahr</span>
                <span class="pub-meta-value">2020</span>
              </div>
              <div class="pub-meta-col">
                <span class="pub-meta-label">Seitenzahl</span>
                <span class="pub-meta-value">20</span>
              </div>
              <div class="pub-meta-col">
                <span class="pub-meta-label">Herausgeber</span>
                <span class="pub-meta-value">
                  <a href="https://www.sfac.or.kr/english/engMain.do" target="_blank" rel="noopener noreferrer">
                    Seoul Foundation for Arts and Culture, Seoul Art Space Mullae
                  </a>
                </span>
              </div>
              <div class="pub-meta-col pub-meta-col-wide">
                <span class="pub-meta-label">Autor</span>
                <span class="pub-meta-value">Kyung Jae Kim</span>
              </div>
            </div>
          </header>
          <div class="pub-grid">
            <div class="pub-image-wrapper" style="aspect-ratio: 1036/735;">
              <img
                src="/publication/MU/MU1.png"
                alt="Das Netzwerk der Klangkunst - 문래예술공장 1"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 909/736;">
              <img
                src="/publication/MU/MU2.png"
                alt="Das Netzwerk der Klangkunst - 문래예술공장 2"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 5000/3337;">
              <img
                src="/publication/MU/MU3.jpg"
                alt="Das Netzwerk der Klangkunst - 문래예술공장 3"
                class="pub-image"
                loading="lazy"
              />
            </div>
            <div class="pub-image-wrapper" style="aspect-ratio: 5000/3337;">
              <img
                src="/publication/MU/MU4.jpg"
                alt="Das Netzwerk der Klangkunst - 문래예술공장 4"
                class="pub-image"
                loading="lazy"
              />
            </div>
          </div>
        </article>
      </div>
    </main>

    <!-- Lightbox Modal -->
    <div class="lightbox" id="pub-lightbox" aria-hidden="true" role="dialog">
      <button class="lightbox-close" aria-label="Close image">&times;</button>
      <button class="lightbox-prev" aria-label="Previous image">&#10094;</button>
      <button class="lightbox-next" aria-label="Next image">&#10095;</button>
      <div class="lightbox-wrapper">
        <img class="lightbox-content" id="pub-lightbox-img" src="" alt="Enlarged publication preview" />
      </div>
    </div>
  </div>
</Layout>

<style>
  .publications-page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    color: #fff;
    overflow-x: hidden;
  }

  .pub-bg-video {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover;
    z-index: -2;
  }

  .pub-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: -1;
  }

  .pub-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 140px 32px 100px;
    position: relative;
    z-index: 1;
  }

  .pub-page-header {
    margin-bottom: 60px;
    animation: fadeIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .pub-page-header h1 {
    font-size: min(3.5rem, 10vw);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    line-height: 1.1;
  }

  .pub-content {
    animation: fadeIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
    opacity: 0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pub-item {
    margin-bottom: 80px;
  }

  .pub-item:last-child {
    margin-bottom: 0;
  }

  .pub-item-header {
    margin-bottom: 24px;
  }

  .pub-title {
    font-size: 1.8rem;
    font-weight: 500;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .pub-subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 300;
  }

  .pub-header-main {
    margin-bottom: 16px;
  }

  .pub-meta-info {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 32px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 16px;
    max-width: 900px;
  }

  .pub-meta-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-meta-col-wide {
    flex-basis: 100%;
  }

  .pub-meta-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.4);
    font-weight: 500;
  }

  .pub-meta-value {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 300;
    line-height: 1.4;
  }

  .pub-meta-value a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    transition: color 0.3s, text-decoration-color 0.3s;
  }

  .pub-meta-value a:hover {
    color: #fff;
    text-decoration-color: #fff;
  }

  @media (min-width: 768px) {
    .pub-meta-col-wide {
      flex-basis: auto;
    }
  }

  /* Responsive image grid / flex scroll */
  .pub-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .pub-grid::-webkit-scrollbar {
    height: 4px;
  }

  .pub-grid::-webkit-scrollbar-track {
    background: transparent;
  }

  .pub-grid::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
  }

  .pub-grid::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .pub-image-wrapper {
    position: relative;
    overflow: hidden;
    height: 380px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.03);
    cursor: zoom-in;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: border-color 0.35s ease;
  }

  .pub-image-wrapper:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .pub-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pub-image-wrapper:hover .pub-image {
    transform: scale(1.04);
  }

  /* Fullscreen Lightbox Modal */
  .lightbox {
    display: none;
    position: fixed;
    z-index: 10000;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    justify-content: center;
    align-items: center;
    cursor: zoom-out;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-wrapper {
    position: relative;
    width: 90%;
    height: 90%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .lightbox-content {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    animation: zoomIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lightbox-close {
    position: absolute;
    top: 40px;
    right: 40px;
    background: none;
    border: none;
    color: #fff;
    font-size: 42px;
    font-weight: 300;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.3s, transform 0.3s;
    z-index: 10010;
  }

  .lightbox-close:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #fff;
    font-size: 38px;
    font-weight: 300;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.3s, transform 0.3s, color 0.3s;
    z-index: 10010;
    padding: 20px;
    user-select: none;
  }

  .lightbox-prev {
    left: 40px;
  }

  .lightbox-next {
    right: 40px;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 1;
    color: #fff;
    transform: translateY(-50%) scale(1.15);
  }

  @media (max-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      font-size: 28px;
      padding: 12px;
    }
    .lightbox-prev {
      left: 16px;
    }
    .lightbox-next {
      right: 16px;
    }
  }

  @media (max-width: 640px) {
    .pub-container {
      padding: 100px 24px 60px;
    }
    
    .pub-image-wrapper {
      height: 280px;
    }

    .lightbox-close {
      top: 24px;
      right: 24px;
      font-size: 32px;
    }
  }
</style>

<script>
  const video = document.querySelector(".pub-bg-video");
  if (video instanceof HTMLVideoElement) {
    const handleTimeStart = () => {
      if (video.currentTime < 20) {
        video.currentTime = 20;
      }
    };

    video.addEventListener("loadedmetadata", handleTimeStart);
    video.addEventListener("timeupdate", () => {
      if (video.currentTime < 20) {
        video.currentTime = 20;
      }
    });

    if (video.readyState >= 1) {
      handleTimeStart();
    }
  }

  // Lightbox functionality
  const lightbox = document.getElementById("pub-lightbox");
  const lightboxImg = document.getElementById("pub-lightbox-img") as HTMLImageElement;
  const closeBtn = document.querySelector(".lightbox-close");
  const prevBtn = document.querySelector(".lightbox-prev");
  const nextBtn = document.querySelector(".lightbox-next");
  const imageWrappers = document.querySelectorAll(".pub-image-wrapper");

  let currentImageSources: string[] = [];
  let currentActiveIndex = 0;

  if (lightbox && lightboxImg) {
    imageWrappers.forEach(wrapper => {
      wrapper.addEventListener("click", () => {
        // Find the parent pub-item to restrict navigation to the same publication
        const parentItem = wrapper.closest(".pub-item");
        if (!parentItem) return;

        // Get all images within this publication
        const parentImages = parentItem.querySelectorAll(".pub-image");
        currentImageSources = Array.from(parentImages)
          .map(img => img.getAttribute("src") || "")
          .filter(src => src !== "");

        const currentImg = wrapper.querySelector("img");
        const currentSrc = currentImg?.getAttribute("src");
        
        if (currentSrc) {
          currentActiveIndex = currentImageSources.indexOf(currentSrc);
          if (currentActiveIndex === -1) currentActiveIndex = 0;
          
          showImage(currentActiveIndex);
          lightbox.classList.add("active");
          lightbox.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
      });
    });

    const showImage = (index: number) => {
      if (index >= 0 && index < currentImageSources.length) {
        lightboxImg.src = currentImageSources[index];
        currentActiveIndex = index;
      }
    };

    const nextImage = () => {
      if (currentImageSources.length === 0) return;
      let nextIndex = currentActiveIndex + 1;
      if (nextIndex >= currentImageSources.length) {
        nextIndex = 0; // loop back to first
      }
      showImage(nextIndex);
    };

    const prevImage = () => {
      if (currentImageSources.length === 0) return;
      let prevIndex = currentActiveIndex - 1;
      if (prevIndex < 0) {
        prevIndex = currentImageSources.length - 1; // loop to last
      }
      showImage(prevIndex);
    };

    const closeLightbox = () => {
      lightbox.classList.remove("active");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => {
        lightboxImg.src = ""; // Clear source to free memory
      }, 350);
    };

    // Close on click anywhere outside or on close btn
    lightbox.addEventListener("click", (e) => {
      if (e.target !== lightboxImg && e.target !== prevBtn && e.target !== nextBtn) {
        closeLightbox();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener("click", closeLightbox);
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        prevImage();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        nextImage();
      });
    }

    // Keydown listeners (Esc and Arrows)
    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("active")) {
        if (e.key === "Escape") {
          closeLightbox();
        } else if (e.key === "ArrowRight") {
          nextImage();
        } else if (e.key === "ArrowLeft") {
          prevImage();
        }
      }
    });
  }
</script>
